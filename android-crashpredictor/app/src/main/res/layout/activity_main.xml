<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="26dp"
            android:paddingBottom="30dp">

            <!-- Wordmark -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/wordmark"
                android:textColor="@color/champagne"
                android:textSize="26sp"
                android:letterSpacing="0.42"
                android:fontFamily="serif" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="@string/tagline"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:gravity="center" />

            <!-- Crash Index dial -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/card_gilded"
                android:padding="18dp">

                <com.marketcrash.predictor.GaugeView
                    android:id="@+id/gauge"
                    android:layout_width="230dp"
                    android:layout_height="230dp"
                    android:layout_gravity="center_horizontal" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/scoreText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:text="0"
                        android:textColor="@color/champagne"
                        android:textSize="52sp"
                        android:fontFamily="sans-serif-thin" />

                    <TextView
                        style="@style/Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/crash_index" />
                </LinearLayout>
            </FrameLayout>

            <!-- Level banner -->
            <LinearLayout
                android:id="@+id/levelBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:background="@drawable/banner_serene"
                android:padding="16dp">

                <TextView
                    android:id="@+id/levelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:letterSpacing="0.14"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/updatedText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Action row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/refreshButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/refresh" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/watchButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/start_watch" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/testButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/test_alert"
                android:textColor="@color/crimson" />

            <!-- Market pulse grid -->
            <TextView
                style="@style/Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/section_markets" />

            <GridLayout
                android:id="@+id/assetGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="2" />

            <!-- Stress signals -->
            <TextView
                style="@style/Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/section_signals" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/card_glass"
                android:padding="16dp">

                <TextView
                    android:id="@+id/signalsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="13.5sp"
                    android:lineSpacingExtra="7dp"
                    android:text="@string/fetching" />
            </LinearLayout>

            <!-- Elite watch -->
            <TextView
                style="@style/Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/section_elite" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/card_glass"
                android:padding="16dp">

                <TextView
                    android:id="@+id/eliteSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/champagne"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/eliteMovers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="6dp" />

                <TextView
                    android:id="@+id/eliteToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/show_all_fortunes"
                    android:textColor="@color/gold"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/eliteFullList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="5dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Bunker trigger -->
            <TextView
                style="@style/Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/section_bunker" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/card_glass"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/nzIndexText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/champagne"
                        android:textSize="34sp"
                        android:fontFamily="sans-serif-thin" />

                    <TextView
                        android:id="@+id/nzIndexLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/nzRoutesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="6dp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Leaders -->
            <TextView
                style="@style/Overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/section_leaders" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/card_glass"
                android:padding="16dp">

                <TextView
                    android:id="@+id/leadersText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="6dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/errorsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/ember"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/disclaimer"
                android:textColor="@color/text_faint"
                android:textSize="10.5sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Full-screen crash alert -->
    <LinearLayout
        android:id="@+id/crashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:background="@drawable/crash_overlay_bg"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/overlayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_title"
            android:textColor="@color/white"
            android:textSize="38sp"
            android:letterSpacing="0.12"
            android:gravity="center"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:id="@+id/overlayScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/champagne"
            android:textSize="22sp"
            android:fontFamily="sans-serif-light" />

        <TextView
            android:id="@+id/overlayReasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dismissOverlayButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/dismiss_alert" />
    </LinearLayout>
</FrameLayout>
