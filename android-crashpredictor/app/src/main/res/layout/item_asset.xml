<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_glass"
    android:padding="14dp">

    <TextView
        android:id="@+id/assetClass"
        style="@style/Overline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="9sp"
        android:textColor="@color/text_faint" />

    <TextView
        android:id="@+id/assetName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/assetPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/champagne"
        android:textSize="17sp"
        android:fontFamily="sans-serif-light"
        android:maxLines="1" />

    <com.marketcrash.predictor.SparklineView
        android:id="@+id/assetSpark"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/assetChange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
