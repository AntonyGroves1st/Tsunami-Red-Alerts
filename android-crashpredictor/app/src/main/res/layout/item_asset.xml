<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_glass"
    android:padding="10dp">

    <TextView
        android:id="@+id/assetClass"
        style="@style/Overline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="8.5sp"
        android:textColor="@color/text_faint" />

    <TextView
        android:id="@+id/assetName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/assetPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/champagne"
        android:textSize="15sp"
        android:fontFamily="sans-serif-light"
        android:maxLines="1" />

    <com.marketcrash.predictor.SparklineView
        android:id="@+id/assetSpark"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/assetChange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
