<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CrashPredictor" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorPrimaryContainer">@color/navy_raised</item>
        <item name="colorOnPrimaryContainer">@color/champagne</item>
        <item name="colorSecondary">@color/gold_soft</item>
        <item name="colorOnSecondary">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="colorSurface">@color/navy_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/navy_raised</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>

    <!-- Small caps-style overline used for section headers. -->
    <style name="Overline">
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
